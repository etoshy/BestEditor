# Copie este arquivo para ".env" (sem o ".example") e preencha suas chaves.
# O ".env" nunca deve ser commitado/compartilhado — ele guarda segredos.

# Chave(s) da API oficial do Pexels (grátis, peça em https://www.pexels.com/api/)
# Uma chave só:
#   PEXELS_API_KEYS=sua_chave_aqui
# Várias chaves, separadas por vírgula — o toolkit alterna automaticamente
# para a próxima assim que uma bater o limite de requisições (rate limit):
#   PEXELS_API_KEYS=chave_um,chave_dois,chave_tres
PEXELS_API_KEYS=

# Chave(s) da API oficial do Pixabay (grátis, peça em https://pixabay.com/api/docs/
# — aparece direto na própria página depois de logar, sem aprovação).
# Mesmo formato: uma chave, ou várias separadas por vírgula.
PIXABAY_API_KEYS=

# Quando as chaves acima estiverem preenchidas, o toolkit/site usa
# automaticamente a API oficial daquele provedor em vez do scraping por
# navegador — mais rápido, sem precisar de Chrome, e sem risco de
# bloqueio. Deixe em branco (ou remova a linha) para continuar usando o
# scraping por navegador pra esse provedor específico.

# Limite total de upload por requisição (MB). Padrão: 10 GB.
MAX_UPLOAD_SIZE_MB=51200
