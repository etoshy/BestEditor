# texto com fim de linha normalizado (Windows/Linux sem bagunçar o diff)
* text=auto
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.bat text eol=crlf

